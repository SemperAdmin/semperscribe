    "enclosures": [],
    "copyTos": [],
    "paragraphs": [
      {
        "id": 1,
        "level": 1,
        "content": "Per references (a) and (b), you are appointed as the Command Designated Directives Manager (CDDM) for this command, effective the date of this letter.",
        "isMandatory": true
      },
      {
        "id": 2,
        "level": 1,
        "content": "You will coordinate with the Marine Corps Directives Management Program at Headquarters Marine Corps for orientation and training, manage the command's Directives Control Point, and coordinate with directives action officers and their offices of primary responsibility to conduct the Directives Review Process."
      },
      {
        "id": 3,
        "level": 1,
        "content": "This appointment remains in effect from the date signed until you leave the assignment or are relieved in writing."
      }
    ]
