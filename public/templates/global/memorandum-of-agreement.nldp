    "copyTos": [],
    "paragraphs": [
      {
        "id": 1,
        "level": 1,
        "content": "Purpose. This Memorandum of Agreement establishes the terms and conditions for shared use of training facilities between MCIWEST and 1st MLG."
      },
      {
        "id": 2,
        "level": 1,
        "content": "Problem. Training facility availability has been constrained due to increased operational tempo and concurrent maintenance requirements."
      },
      {
        "id": 3,
        "level": 1,
        "content": "Scope. This agreement applies to all training areas and ranges within MCB Camp Pendleton."
      },
      {
        "id": 4,
        "level": 1,
        "content": "Agreement. Both parties agree to the following conditions."
      },
      {
        "id": 5,
        "level": 2,
        "content": "1st MLG will have priority access to the Logistics Operations Training Facility on Tuesdays and Thursdays."
      },
      {
        "id": 6,
        "level": 2,
        "content": "MCIWEST will provide maintenance support for shared facilities per a quarterly maintenance schedule."
      },
      {
        "id": 7,
        "level": 1,
        "content": "Effective Date. This agreement is effective upon signature by both parties and remains in effect for 24 months."
      }
    ]
  }
