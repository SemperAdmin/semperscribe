      {
        "id": 1,
        "level": 1,
        "content": "Start an endorsement on a new page. Number each page of your endorsement and continue the sequence of numbers from the previous endorsement or from the basic letter if you are the first endorser.",
        "isMandatory": true
      },
      {
        "id": 2,
        "level": 1,
        "content": "Every \"new page\" endorsement must repeat the basic letter's SSIC, identify the basic letter in the endorsement line, and use the basic letter's subject as its own."
