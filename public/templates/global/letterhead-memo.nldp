    "paragraphs": [
      {
        "id": 1,
        "level": 0,
        "content": "1. This memorandum provides training guidance for all units assigned to 1st Marine Division during FY26."
      },
      {
        "id": 2,
        "level": 0,
        "content": "2. Commander's Intent. Focus training efforts on combined arms integration and expeditionary operations."
      },
      {
        "id": 3,
        "level": 1,
        "content": "a. All infantry battalions will complete at least one battalion-level field exercise per quarter."
      },
      {
        "id": 4,
        "level": 1,
        "content": "b. Supporting units will integrate with supported maneuver elements during all major exercises."
      },
      {
        "id": 5,
        "level": 2,
        "content": "(1) Artillery batteries will conduct a minimum of two live-fire exercises per quarter."
      },
      {
        "id": 6,
        "level": 2,
        "content": "(2) Combat engineer units will support breaching operations during each infantry field exercise."
      },
      {
        "id": 7,
        "level": 0,
        "content": "3. Report training readiness status monthly per reference (a)."
      }
    ]
  }
